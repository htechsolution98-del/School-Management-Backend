# Django Settings
SECRET_KEY=your-django-secret-key
DEBUG=True

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=postgresql://user:password@localhost:5432/sms_db

# Razorpay Configuration
RAZOR_PAY_KEY_ID=rzp_test_your_key_id
RAZOR_PAY_SECRET_KEY=your_razorpay_secret_key

# Email SMTP Configuration
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password

# Face++ Facial Recognition API
FACEPP_API_KEY=your_facepp_api_key
FACEPP_API_SECRET=your_facepp_api_secret

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Redis Configuration (Optional)
REDIS_URL=redis://127.0.0.1:6379/1
